DUMMY_MODE=true
CODEHUB_BE_URL=https://codehub-api.internal.com
# 로컬 HTTPS(mkcert) 환경에서는 false로 설정 (Python httpx가 mkcert CA를 인식 못 함)
# 운영 환경에서는 반드시 true 유지
CODEHUB_BE_VERIFY_SSL=true
IDP_ENTITY_ID=https://idp.internal.com/oauth2/authorize
IDP_CLIENT_ID=codehub-rbac-manage
SP_REDIRECT_URL=https://localhost:8000/api/auth/acs
IDP_CERT_FILE_PATH=./resources/cert
IDP_CERT_FILE_NAME=idp.pem
JWT_SECRET_KEY=your-secret-key-change-in-production
FRONTEND_URL=https://localhost:3000
