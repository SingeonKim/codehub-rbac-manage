# 빌드 컨텍스트에서 제외 (이미지 크기 + 빌드 속도)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 환경 파일은 절대 이미지에 포함하지 않는다 (k8s Secret/ConfigMap으로 주입)
.env
.env.*
!.env.example

# 인증서 (mkcert 로컬 개발용) — k8s에서는 별도 Secret 마운트
../certs
resources/cert/*.pem
resources/cert/*.key

# IDE / OS
.idea/
.vscode/
.DS_Store

# Git
.git
.gitignore
